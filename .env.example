# Порт внутри контейнера
PORT=3000

# Путь к SQLite (совпадает с volume в docker-compose)
DB_PATH=/app/data/wishlist.db

# Секретный токен для admin-эндпоинтов (/api/admin/*)
# Задай случайную строку: openssl rand -hex 32
ADMIN_TOKEN=change_me_please

# NODE_ENV: development | production
NODE_ENV=production
